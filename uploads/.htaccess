# Esta carpeta solo debe servir archivos estaticos subidos por usuarios
# (evidencias, importaciones). Nunca debe ejecutar codigo.

Options -ExecCGI -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

AddHandler default-handler .php .php3 .php4 .php5 .php7 .phtml .pht .phar .cgi .pl .py .sh

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pht|phar|cgi|pl|py|sh|exe|dll)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
