# Configuración de la base de datos
DB_HOST=localhost
DB_NAME=sena_seguimiento
DB_USER=root
DB_PASS=""

# Configuración de la aplicación
DEV_MODE=true

# Dominio real de producción (sin http/https), usado para construir enlaces
# absolutos (ej. recuperación de contraseña) sin confiar en el header Host
# de la petición. OBLIGATORIO en producción para evitar Host Header Injection.
# APP_HOST=miapp.midominio.com

# === Envío de correo (SMTP) ===
# Usado por core/Services/MailService.php, p. ej. para el enlace de
# recuperación de contraseña. Es agnóstico del proveedor: para cambiar de
# Gmail a otro SMTP basta con cambiar estos valores, sin tocar código.
#
# Si MAIL_USERNAME o MAIL_PASSWORD están vacíos, NO se intenta enviar: se
# registra el motivo en logs/mail.log y la app continúa con normalidad
# (así el entorno local funciona sin credenciales).
#
# Gmail requiere una "contraseña de aplicación" (con verificación en dos
# pasos activada); la contraseña normal de la cuenta NO funciona.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres
MAIL_FROM_ADDRESS=tu-correo@gmail.com
MAIL_FROM_NAME="SENA Seguimiento"
# tls (STARTTLS, puerto 587) | ssl (SMTPS, puerto 465) | none (sin cifrado)
MAIL_ENCRYPTION=tls

# Opcionales
# Segundos de espera al conectar con el SMTP antes de rendirse (def. 15).
# MAIL_TIMEOUT=15
# Poner en 1 para volcar el diálogo SMTP completo en logs/mail.log al depurar.
# MAIL_DEBUG=0
