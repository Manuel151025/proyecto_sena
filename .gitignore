# === Configuración sensible ===
config/database.php
.env
.env.*
!.env.example

# === Logs ===
logs/*.log
logs/*.txt
!logs/.htaccess

# === Archivos subidos por usuarios ===
uploads/*
assets/uploads/
!uploads/.htaccess

# === Caché y temporales ===
cache/*
!cache/.htaccess
tmp/
temp/
*.tmp
*.cache

# === Dependencias (si se agregan en el futuro) ===
vendor/
node_modules/

# === IDE y editores ===
.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# === Sistema operativo ===
.DS_Store
Thumbs.db
desktop.ini

# === PHP ===
*.log
error_log

# === Base de datos local (no subir dumps personales) ===
*.sql
# El esquema sí se versiona: es la fuente única de la estructura (solo DDL,
# sin datos). Lo genera bin/volcar-esquema.php.
!database/esquema.sql

# === install.php (peligroso en producción) ===
install.php

# === Otros archivos sensibles o temporales ===
.vscode/
settings.json
scratch/
# Script de depuracion puntual, no forma parte del sistema
test_accents.php


# Cache de PHPUnit
.phpunit.cache/
.phpunit.result.cache
